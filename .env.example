# --- required ---------------------------------------------------------------
# Clients (desktop app, terminal UI, runners) authenticate with this token.
# Generate one with: openssl rand -hex 32
MULTICHAT_API_TOKEN=change-me
# Postgres password (letters and digits only, it is embedded in a URL).
POSTGRES_PASSWORD=change-me

# --- optional ---------------------------------------------------------------
# Encrypts API keys / SSH secrets at rest. If empty, one is generated into the
# appdata volume on first start (keep that volume, or set this explicitly).
MULTICHAT_SECRET_KEY=
# Where the server listens on the host.
SERVER_BIND=0.0.0.0
SERVER_PORT=8000

# --- vendor keys referenced from config.yaml as ${NAME} ---------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GITHUB_MODELS_TOKEN=
CURSOR_API_KEY=
COPILOT_GITHUB_TOKEN=
BRAVE_API_KEY=
