# --- required ---------------------------------------------------------------
# Clients (desktop app, terminal UI, runners) authenticate with this token.
# Generate one with: openssl rand -hex 32
MULTICHAT_API_TOKEN=change-me
# Postgres password (letters and digits only, it is embedded in a URL).
POSTGRES_PASSWORD=change-me

# --- optional ---------------------------------------------------------------
# Encrypts API keys / SSH secrets at rest. Any random string of 16+ characters
# (e.g. `openssl rand -hex 32`). If empty, a key is generated into the appdata
# volume on first start. Don't change it later: stored keys from the API/desktop
# app would become unreadable (keys from config.yaml are simply re-encrypted).
MULTICHAT_SECRET_KEY=
# Where the server listens on the host.
SERVER_BIND=0.0.0.0
SERVER_PORT=8000

# --- vendor keys referenced from config.yaml as ${NAME} ---------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GITHUB_MODELS_TOKEN=
CURSOR_API_KEY=
COPILOT_GITHUB_TOKEN=
BRAVE_API_KEY=

# Public domain for compose.https.yaml (HTTPS via Caddy + Let's Encrypt)
MULTICHAT_DOMAIN=
